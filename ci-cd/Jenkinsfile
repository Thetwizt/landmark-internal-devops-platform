pipeline {
    agent any

    environment {
        APP_NAME = "client-service"
        AWS_REGION = "eu-west-2"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate') {
            steps {
                sh 'echo "Running basic validation checks"'
            }
        }

        stage('Build') {
            steps {
                sh 'echo "Building application artifact"'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'echo "Building Docker image for ${APP_NAME}"'
            }
        }

        stage('Deploy to Dev') {
            when {
                branch 'develop'
            }
            steps {
                sh 'echo "Deploying to DEV environment"'
            }
        }

        stage('Deploy to Staging') {
            when {
                branch 'main'
            }
            steps {
                input message: 'Approve deployment to STAGING?'
                sh 'echo "Deploying to STAGING environment"'
            }
        }
    }

    post {
        failure {
            echo 'Pipeline failed. Notifying DevOps team.'
        }
        success {
            echo 'Pipeline completed successfully.'
        }
    }
}
