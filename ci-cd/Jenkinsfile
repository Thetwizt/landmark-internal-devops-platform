pipeline {
    agent any

    environment {
        AWS_REGION = "us-east-1"
        AWS_ACCOUNT_ID = "371601827796"               // Filled in your actual AWS account ID
        ECR_REPO = "landmark-web-app"
        IMAGE_TAG = "${BUILD_NUMBER}"
        ECR_URI = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}"
    }

    tools {
        jdk 'jdk-21'                                  // Ensure this matches Jenkins configured JDK tool
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Thetwizt/landmark-internal-devops-platform.git',
                    credentialsId: 'github-pat'      // Make sure this Jenkins credential exists (PAT)
            }
        }

   stage('Build Docker Image') {
    steps {
        dir('services/web-app') {
            sh '''
            docker build -t ${ECR_REPO}:${IMAGE_TAG} .
            docker tag ${ECR_REPO}:${IMAGE_TAG} ${ECR_URI}:${IMAGE_TAG}
            '''
        }
    }
}


            }
        }

        stage('Authenticate to ECR') {
            steps {
                sh '''
                aws ecr get-login-password --region ${AWS_REGION} \
                | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                '''
            }
        }

        stage('Push Image to ECR') {
            steps {
                sh '''
                docker push ${ECR_URI}:${IMAGE_TAG}
                '''
            }
        }

        stage('Deploy to EC2') {
            steps {
                sh '''
                docker stop web-app || true
                docker rm web-app || true

                docker run -d \
                  --name web-app \
                  -p 3000:3000 \
                  ${ECR_URI}:${IMAGE_TAG}
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Build & Deployment Successful"
        }
        failure {
            echo "❌ Build Failed — Check Logs"
        }
    }
}

