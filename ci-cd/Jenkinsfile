pipeline {
    agent any

    environment {
        AWS_REGION     = "us-east-1"
        AWS_ACCOUNT_ID = "371601827796" 
        ECR_REPO       = "landmark-web-app"
        IMAGE_TAG      = "${BUILD_NUMBER}"
        ECR_URI        = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}"
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main', 
                    url: 'https://github.com/Thetwizt/landmark-internal-devops-platform.git', 
                    credentialsId: 'github-pat'
            }
        }

        stage('Prepare ECR') {
            steps {
                sh """
                aws ecr create-repository --repository-name ${ECR_REPO} --region ${AWS_REGION} || true
                aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_URI}
                """
            }
        }

        stage('Build & Tag') {
            steps {
                dir('services/web-app') {
                    sh """
                    docker build -t ${ECR_URI}:${IMAGE_TAG} .
                    docker tag ${ECR_URI}:${IMAGE_TAG} ${ECR_URI}:latest
                    """
                }
            }
        }

        stage('Push to AWS') {
            steps {
                sh """
                docker push ${ECR_URI}:${IMAGE_TAG}
                docker push ${ECR_URI}:latest
                """
            }
        }
stage('Blue-Green Deploy') {
    steps {
        sh """
        echo "🚀 Starting standby container on port 3001..."

        # 1. Clean up any previous failed standby containers
        docker rm -f landmark-container-new || true

        # 2. Start the new version on 3001
        docker run -d \
          --name landmark-container-new \
          --restart unless-stopped \
          -p 3001:3000 \
          -e NODE_ENV=production \
          -e APP_VERSION=${IMAGE_TAG} \
          ${ECR_URI}:${IMAGE_TAG}

        echo "⌛ Waiting 10s for initialization..."
        sleep 10

        # 3. Health Check (Using curl -f to fail the stage if not 200 OK)
        echo "🔍 Checking health of standby..."
        curl -f http://localhost:3001 || { 
            echo "❌ New version is UNHEALTHY. Cleaning up..."; 
            docker rm -f landmark-container-new; 
            exit 1; 
        }

        echo "✅ Health check passed. Swapping traffic..."

        # 4. THE ATOMIC SWAP
        # We stop the old one first, then immediately swap the new one to its name
        docker stop landmark-container || true
        docker rm landmark-container || true
        
        # We don't delete 'new'—we RENAME it so it becomes the primary
        # Note: Port 3001 will still be active, but we can restart it on 3000 now
        docker stop landmark-container-new
        docker rename landmark-container-new landmark-container
        
        # Final restart on the correct production port
        docker run -d \
          --name landmark-container \
          --restart unless-stopped \
          -p 3000:3000 \
          -e NODE_ENV=production \
          ${ECR_URI}:${IMAGE_TAG}

        docker rm -f landmark-container-new || true
        echo "🎉 Blue-Green deployment complete."
        """
    }
}
    } // End of Stages

    post {
        always {
            cleanWs()
            sh "docker rmi ${ECR_URI}:${IMAGE_TAG} || true"
            sh "docker rmi ${ECR_URI}:latest || true"
        }
        success {
            echo "✅ Successfully deployed version: ${IMAGE_TAG}"
        }
        failure {
            echo "❌ Build Failed - Check Console Output"
        }
    }
} // End of Pipeline