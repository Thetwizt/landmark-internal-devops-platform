pipeline {
    agent any
    
    environment {
        // 1. UPDATE THIS with your Terraform Output
        DOCKER_HOST_IP = "100.53.183.14" 
        
        // 2. UPDATE THIS with your ECR URI
        ECR_URI = 371601827796.dkr.ecr.us-east-1.amazonaws.com/landmark-web-app
        IMAGE_TAG = "v${BUILD_NUMBER}"
    }

    stages {
        stage('Build & Push') {
            steps {
                // This part stays the same from your previous days
                sh "docker build -t ${ECR_URI}:${IMAGE_TAG} ."
                sh "aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin ${ECR_URI}"
                sh "docker push ${ECR_URI}:${IMAGE_TAG}"
            }
        }

        stage('Remote Deploy to Terraform Host') {
            steps {
                // This is the NEW Day 17 logic
                sshagent(['docker-host-key']) {
                    sh """
                    ssh -o StrictHostKeyChecking=no ec2-user@${DOCKER_HOST_IP} << 'EOF'
                        # Login to ECR on the REMOTE host
                        aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin ${ECR_URI}
                        
                        # Clean up and Run
                        docker stop landmark-app || true
                        docker rm landmark-app || true
                        docker pull ${ECR_URI}:${IMAGE_TAG}
                        docker run -d --name landmark-app -p 80:3000 ${ECR_URI}:${IMAGE_TAG}
                    EOF
                    """
                }
            }
        }
    }
}