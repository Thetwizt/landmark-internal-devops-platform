pipeline {
    agent any

    environment {
        AWS_REGION     = "us-east-1"
        AWS_ACCOUNT_ID = "371601827796" 
        ECR_REPO       = "landmark-web-app"
        IMAGE_TAG      = "${BUILD_NUMBER}"
        ECR_URI        = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}"
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main', 
                    url: 'https://github.com/Thetwizt/landmark-internal-devops-platform.git', 
                    credentialsId: 'github-pat'
            }
        }

        stage('Prepare ECR') {
            steps {
                sh """
                aws ecr create-repository --repository-name ${ECR_REPO} --region ${AWS_REGION} || true
                aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_URI}
                """
            }
        }

        stage('Build & Tag') {
            steps {
                dir('services/web-app') {
                    sh """
                    docker build -t ${ECR_URI}:${IMAGE_TAG} .
                    docker tag ${ECR_URI}:${IMAGE_TAG} ${ECR_URI}:latest
                    """
                }
            }
        }

        stage('Push to AWS') {
            steps {
                sh """
                docker push ${ECR_URI}:${IMAGE_TAG}
                docker push ${ECR_URI}:latest
                """
            }
        }
stage('Deploy to EC2') {
    steps {
        sh """
        echo "Stopping old container..."
        docker stop landmark-container || true
        docker rm landmark-container || true

        echo "Starting new container..."
        docker run -d \
          --name landmark-container \
          --restart unless-stopped \
          -p 3000:3000 \
          -e NODE_ENV=production \
          -e APP_VERSION=${IMAGE_TAG} \
          ${ECR_URI}:${IMAGE_TAG}

        echo "Deployment complete."
        """
    }
}

    } // End of Stages

    post {
        always {
            cleanWs()
            sh "docker rmi ${ECR_URI}:${IMAGE_TAG} || true"
            sh "docker rmi ${ECR_URI}:latest || true"
        }
        success {
            echo "✅ Successfully deployed version: ${IMAGE_TAG}"
        }
        failure {
            echo "❌ Build Failed - Check Console Output"
        }
    }
} // End of Pipeline